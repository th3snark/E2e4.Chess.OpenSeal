<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net45;netstandard2.0;netstandard2.1;net10.0</TargetFrameworks>
    <Description>C# implementation of the FICS timeseal/openseal handshake encoder, derived from openseal.c by Marcello Mamino (GPL v2 or later).</Description>
    <PackageTags>chess;fics;timeseal;openseal</PackageTags>
    <PackageReleaseNotes>See https://github.com/th3snark/E2e4.Chess.OpenSeal/releases for what changed in each version.</PackageReleaseNotes>
    <PackageLicenseExpression>GPL-2.0-or-later</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/th3snark/E2e4.Chess.OpenSeal</PackageProjectUrl>
    <RepositoryUrl>https://github.com/th3snark/E2e4.Chess.OpenSeal</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- ArgumentNullException.ThrowIfNull needs .NET 6; this library still targets net45 and netstandard2.0. -->
    <NoWarn>$(NoWarn);CA1510</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="E2e4.Chess.OpenSeal.Test" />
  </ItemGroup>

  <!-- nuget.org drops raw HTML such as the README's <img> icon and shows it as text, so the packed README is a copy without that line (GitHub keeps it). -->
  <Target Name="PackReadmeWithoutIcon" BeforeTargets="_GetPackageFiles;GenerateNuspec">
    <PropertyGroup>
      <PackedReadme>$(MSBuildProjectDirectory)/obj/nuget/README.md</PackedReadme>
      <PackedReadmeText>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../../README.md'))</PackedReadmeText>
      <PackedReadmeText>$([System.Text.RegularExpressions.Regex]::Replace('$(PackedReadmeText)', '(?m)^&lt;img [^\r\n]*\r?\n(\r?\n)?', ''))</PackedReadmeText>
    </PropertyGroup>
    <WriteLinesToFile File="$(PackedReadme)" Lines="$([MSBuild]::Escape('$(PackedReadmeText)'))" Overwrite="true" />
    <ItemGroup>
      <None Include="$(PackedReadme)" Pack="true" PackagePath="\" />
    </ItemGroup>
  </Target>

</Project>
